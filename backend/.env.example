# AWS Region for Kivya. Keep Mumbai as the source region.
AWS_REGION=ap-south-1

# Set this only after verifying the exact Bedrock inference profile/model ID
# and confirming model access in the AWS account.
BEDROCK_MODEL_ID=

# Generate a long random token outside source control. Never commit the real value.
KIVYA_API_TOKEN=

# Comma-separated trusted app origins if a browser client is used.
# Native Android clients do not use browser CORS.
CORS_ORIGINS=

# Server-side output cap. The application clamps this to 64..1200.
MAX_OUTPUT_TOKENS=600

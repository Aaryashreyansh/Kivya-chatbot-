# AWS Region for Kivya. Keep Mumbai as the source region.
AWS_REGION=ap-south-1

# Gemini is the current online provider. Store the real key only in the host secret manager.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45

# Generate at least 32 random bytes. Never commit the real value or embed it in an APK.
KIVYA_API_TOKEN=

# Comma-separated trusted app origins if a browser client is used.
# Native Android clients do not use browser CORS.
CORS_ORIGINS=

# Server-side output cap. The application clamps this to 64..1200.
MAX_OUTPUT_TOKENS=600
RATE_LIMIT_PER_MINUTE=30

# Database: SQLite for local development; PostgreSQL for hosted production.
DATABASE_URL=sqlite:///./kivya.db
# Example production format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

AWS_REGION=ap-south-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
GUEST_SESSION_DAYS=30
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=
MAX_OUTPUT_TOKENS=600
